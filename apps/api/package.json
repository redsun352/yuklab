{
  "name": "@yuklab/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@fastify/cors": "11.0.1",
    "@fastify/jwt": "9.1.0",
    "@fastify/rate-limit": "10.2.1",
    "@fastify/websocket": "11.0.2",
    "@yuklab/database": "workspace:*",
    "@yuklab/types": "workspace:*",
    "fastify": "5.4.0",
    "ioredis": "5.7.0",
    "jose": "6.1.0",
    "prisma": "6.15.0",
    "ws": "8.18.3",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/ws": "8.18.1",
    "eslint": "8.57.1",
    "tsx": "4.20.3",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
